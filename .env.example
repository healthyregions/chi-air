DEBUG=
REACT_APP_MAPBOX_TOKEN=
REACT_APP_AQ_ENDPOINT=

# Contact form (Cloudflare Turnstile)
# Public site key, used by the browser.
# For local testing, Cloudflare's always-pass test key is 1x00000000000000000000AA
REACT_APP_TURNSTILE_SITE_KEY=

# Server-only values, read by netlify/functions/contact.js.
# Do NOT prefix these with REACT_APP_, or they will be baked into the public bundle.
# For local testing, Cloudflare's always-pass test secret is 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# endpoint for Google Sheet form submission
CONTACT_SHEET_URL=
# endpoint for Slack App form submission
CONTACT_SLACK_WEBHOOK_URL=

# S3 URL segments for fetching Chicago AQ data
REACT_APP_S3_ENDPOINT_URL=https://s3.us-east-2.amazonaws.com
REACT_APP_S3_BUCKET_NAME=chicago-aq

# Uncomment & rebuild to use MinIO instead (for local development)
# REACT_APP_S3_ENDPOINT_URL=http://localhost:9000
